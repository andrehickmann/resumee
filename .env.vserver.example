# Vorlage fuer die .env neben compose.prod.yaml auf dem vServer.
# Nach /opt/resumee/.env kopieren und anpassen. Nicht ins Repo aufnehmen.

# Die vollstaendige Traefik-Regel. Beim Testlauf vor dem DNS-Umzug steht hier
# nur der Testname, z. B.:
#   RESUMEE_HOST_RULE=Host(`neu.hickmann-kuschnereit.de`)
RESUMEE_HOST_RULE=Host(`hickmann-kuschnereit.de`) || Host(`www.hickmann-kuschnereit.de`)

# Zum Testen auf letsencrypt-staging stellen – die Zertifikate sind im Browser
# ungueltig, verbrauchen aber keine echten Versuche.
RESUMEE_TRAEFIK_CERTRESOLVER=letsencrypt

# Vorgaben der Traefik-Installation; nur setzen, wenn sie abweichen.
# RESUMEE_TRAEFIK_NETWORK=traefik
# RESUMEE_TRAEFIK_ENTRYPOINT=websecure

# Baustellenseite statt Inhalt ausliefern. Wirkt erst nach neuem Bauen.
VITE_UNDER_CONSTRUCTION=false
